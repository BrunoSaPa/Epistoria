# Install as /etc/epistoria/backup.env with owner epistoria and mode 0600.
# This file contains paths and rclone remote names, not database or object-store secrets.
EPISTORIA_COMPOSE_FILE=/opt/epistoria/infra/production-compose.yml
EPISTORIA_COMPOSE_ENV_FILE=/etc/epistoria/production.env
EPISTORIA_PRODUCTION_ENV_FILE=/etc/epistoria/production.env
EPISTORIA_BACKUP_ROOT=/var/backups/epistoria
EPISTORIA_OBJECT_SOURCE=epistoria-r2:epistoria-assets
EPISTORIA_OBJECT_MIRROR=/var/lib/epistoria-object-mirror
EPISTORIA_MIRROR_VERIFY_MODE=metadata
EPISTORIA_MIRROR_CHECKERS=4
EPISTORIA_RETAIN_DAILY=7
EPISTORIA_RETAIN_WEEKLY=5
EPISTORIA_RETAIN_MONTHLY=12
