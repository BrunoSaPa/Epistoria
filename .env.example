# Copy to .env for local development. Never commit the populated file.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://epistoria:epistoria-local@localhost:55432/epistoria?schema=public
BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-an-independent-32-byte-secret

# Local MinIO. R2 and other S3-compatible services use the same interface.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=epistoria-assets
S3_ACCESS_KEY_ID=epistoria
S3_SECRET_ACCESS_KEY=epistoria-local-secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# The trusted Mac uses services/worker/.env.example so it never inherits server secrets.
