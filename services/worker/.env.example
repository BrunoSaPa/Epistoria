# Copy to services/worker/.env and set mode 0600. Never add recovery words.
EPISTORIA_API_URL=http://localhost:3000/v1
EPISTORIA_DEVICE_ID=
EPISTORIA_DEVICE_TOKEN=
EPISTORIA_ACCOUNT_ID=
EPISTORIA_KEYCHAIN_SERVICE=com.epistoria.worker.account-key
EPISTORIA_AI_PROVIDER=openai
EPISTORIA_SESSION_DIGEST_MODEL=gpt-5.6-terra
EPISTORIA_SESSION_DIGEST_PROMPT_VERSION=session-digest/v1
EPISTORIA_POLL_SECONDS=10
EPISTORIA_MAXIMUM_ASSET_BYTES=268435456

# GPT-5.6 Terra standard rates checked 2026-08-09; recheck before deployment.
EPISTORIA_MODEL_INPUT_USD_PER_MILLION=2
EPISTORIA_MODEL_OUTPUT_USD_PER_MILLION=12
OPENAI_API_KEY=
EPISTORIA_PROVIDER_KEYCHAIN_SERVICE=com.epistoria.worker.provider-profile
AI_MONTHLY_SOFT_BUDGET_USD=5
