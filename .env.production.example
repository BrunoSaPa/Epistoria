# Copy to .env.production on the server and set mode 0600. Never commit the populated file.
NODE_ENV=production
API_PORT=3000
POSTGRES_DB=epistoria
POSTGRES_USER=epistoria
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_URL=postgresql://epistoria:replace-with-the-same-url-safe-password@postgres:5432/epistoria?schema=public
BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-an-independent-32-byte-secret

# Cloudflare R2 (or another private S3-compatible bucket).
S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=epistoria-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_TTL_SECONDS=900

# Caddy obtains and renews TLS certificates for this hostname.
API_HOSTNAME=sync.example.com
ACME_EMAIL=you@example.com

