{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistoria.local/contracts/sync-wire-v1.schema.json",
  "title": "Epistoria sync push v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["wireVersion", "deviceId", "mutations"],
  "properties": {
    "wireVersion": { "const": 1 },
    "deviceId": { "$ref": "#/$defs/uuid" },
    "mutations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/mutation" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sealed": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cryptoVersion", "contentVersion", "sealedDek", "sealedContent", "payloadSize"],
      "properties": {
        "cryptoVersion": { "type": "integer", "minimum": 1, "maximum": 255 },
        "contentVersion": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sealedDek": { "$ref": "#/$defs/sealed" },
        "sealedContent": { "$ref": "#/$defs/sealed" },
        "dedupeTag": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "payloadSize": { "type": "integer", "minimum": 0, "maximum": 2097152 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "entityId", "entityType", "operation", "baseRevision", "relationIds", "clientModifiedAt", "envelope"],
      "properties": {
        "mutationId": { "$ref": "#/$defs/uuid" },
        "entityId": { "$ref": "#/$defs/uuid" },
        "entityType": {
          "enum": ["AREA", "TOPIC_AREA", "COLLECTION", "COLLECTION_ITEM", "INSTITUTION", "ACADEMIC_TERM", "COURSE", "STUDY_SESSION", "NOTE", "NOTE_PAGE", "NOTE_BLOCK", "TRASH_ENTRY", "RESOURCE", "ASSET", "ANNOTATION", "SESSION_NOTE", "SESSION_RESOURCE", "AI_ARTIFACT", "RECOGNITION_ARTIFACT", "RECOGNITION_DECISION", "TRANSCRIPT_CORRECTION", "SOURCE_VERSION", "EVIDENCE", "CONCEPT", "CONCEPT_EVIDENCE", "CONCEPT_LINK", "KNOWLEDGE_MAP", "STUDY_GOAL", "UNRESOLVED_QUESTION", "SESSION_ACTIVITY", "FLASHCARD_DECK", "FLASHCARD", "FLASHCARD_REVISION", "FLASHCARD_REVIEW", "TOPIC_SCOPE_SNAPSHOT", "TEST_BLUEPRINT", "PRACTICE_TEST", "TEST_QUESTION", "TEST_ATTEMPT", "TEST_RESPONSE", "STUDY_RECOMMENDATION", "RECOMMENDATION_RESPONSE", "AUTOMATION_GRANT", "TUTOR_SESSION", "TUTOR_TURN", "LEARNING_SIGNAL"]
        },
        "operation": { "enum": ["UPSERT", "DELETE"] },
        "baseRevision": { "type": "integer", "minimum": 0 },
        "parentId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "relationIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "clientModifiedAt": { "type": "string", "format": "date-time" },
        "envelope": { "$ref": "#/$defs/envelope" }
      }
    }
  }
}
