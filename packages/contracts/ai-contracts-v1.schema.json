{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistoria.local/contracts/ai-contracts-v1.schema.json",
  "title": "Epistoria trusted processing contracts v1",
  "oneOf": [
    { "$ref": "#/$defs/sessionDigestRequest" },
    { "$ref": "#/$defs/sessionDigest" },
    { "$ref": "#/$defs/pdfExtractionRequest" },
    { "$ref": "#/$defs/noteQueryRequest" },
    { "$ref": "#/$defs/noteQueryResponse" },
    { "$ref": "#/$defs/mathAssistanceRequest" },
    { "$ref": "#/$defs/mathAssistanceResponse" },
    { "$ref": "#/$defs/sourceAnalysisRequest" },
    { "$ref": "#/$defs/sourceQueryRequest" },
    { "$ref": "#/$defs/sourceGuideResponse" },
    { "$ref": "#/$defs/sourceQueryResponse" },
    { "$ref": "#/$defs/providerConfigurationRequest" },
    { "$ref": "#/$defs/providerConfigurationArtifact" },
    { "$ref": "#/$defs/localOCRRequest" },
    { "$ref": "#/$defs/localOCRResponse" },
    { "$ref": "#/$defs/ocrArtifact" },
    { "$ref": "#/$defs/ocrCorrection" },
    { "$ref": "#/$defs/localModelControlRequest" },
    { "$ref": "#/$defs/localModelStatusArtifact" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "providerRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileId", "configurationRevisionId", "displayName", "adapter", "baseURL", "textModel", "capabilities", "structuredOutput"],
      "properties": {
        "schemaVersion": { "const": "provider-route/v1" },
        "profileId": { "$ref": "#/$defs/uuid" },
        "configurationRevisionId": { "$ref": "#/$defs/uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "adapter": { "enum": ["OPENAI_RESPONSES", "OPENAI_COMPATIBLE", "ANTHROPIC_MESSAGES", "GEMINI_GENERATE_CONTENT"] },
        "baseURL": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "textModel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "transcriptionModel": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["TEXT", "VISION", "TRANSCRIPTION", "STRUCTURED_OUTPUT"] } },
        "structuredOutput": { "type": "boolean" }
      }
    },
    "sourceRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sourceAnalysisRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "sourceId", "sourceVersionId", "title", "outputLanguage", "assetId", "assetKey", "expectedDedupeTag", "includeImages", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "source-analysis-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "sourceId": { "$ref": "#/$defs/uuid" },
        "sourceVersionId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "outputLanguage": { "type": "string", "minLength": 2, "maxLength": 64 },
        "assetId": { "$ref": "#/$defs/uuid" },
        "assetKey": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$" },
        "expectedDedupeTag": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "includeImages": { "type": "boolean" },
        "disclosureAcknowledged": { "const": true },
        "providerRoute": { "$ref": "#/$defs/providerRoute" }
      }
    },
    "sourceQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "sourceId", "sourceVersionId", "title", "outputLanguage", "assetId", "assetKey", "expectedDedupeTag", "includeImages", "disclosureAcknowledged", "question"],
      "properties": {
        "schemaVersion": { "const": "source-query-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "sourceId": { "$ref": "#/$defs/uuid" },
        "sourceVersionId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "outputLanguage": { "type": "string", "minLength": 2, "maxLength": 64 },
        "assetId": { "$ref": "#/$defs/uuid" },
        "assetKey": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$" },
        "expectedDedupeTag": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "includeImages": { "type": "boolean" },
        "disclosureAcknowledged": { "const": true },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "providerRoute": { "$ref": "#/$defs/providerRoute" }
      }
    },
    "sourceGuideStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "sourceGuideTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "explanation", "sourceIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "suggestedSourceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "sourceIds"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "sourceGuideResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourceLanguage", "outputLanguage", "summary", "translatedSummary", "keyTopics", "suggestedQuestions", "imageInsights", "coverageGaps"],
      "properties": {
        "schemaVersion": { "const": "source-guide-response/v1" },
        "sourceLanguage": { "type": "string", "minLength": 1, "maxLength": 500 },
        "outputLanguage": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sourceGuideStatement" } },
        "translatedSummary": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/sourceGuideStatement" } },
        "keyTopics": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/sourceGuideTopic" } },
        "suggestedQuestions": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/suggestedSourceQuestion" } },
        "imageInsights": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/sourceGuideStatement" } },
        "coverageGaps": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "sourceQueryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "answer", "insufficientEvidence", "followUpQuestions"],
      "properties": {
        "schemaVersion": { "const": "source-query-response/v1" },
        "answer": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/sourceGuideStatement" } },
        "insufficientEvidence": { "type": "boolean" },
        "followUpQuestions": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "providerConfigurationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "operation", "profileId", "capabilities", "structuredOutput", "makeActive", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "provider-configuration-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["UPSERT", "ACTIVATE", "DELETE"] },
        "profileId": { "$ref": "#/$defs/uuid" },
        "configurationRevisionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "displayName": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "adapter": { "type": ["string", "null"], "enum": ["OPENAI_RESPONSES", "OPENAI_COMPATIBLE", "ANTHROPIC_MESSAGES", "GEMINI_GENERATE_CONTENT", null] },
        "baseURL": { "type": ["string", "null"], "maxLength": 2048 },
        "apiKey": { "type": ["string", "null"], "minLength": 1, "maxLength": 8192 },
        "textModel": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "transcriptionModel": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "capabilities": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["TEXT", "VISION", "TRANSCRIPTION", "STRUCTURED_OUTPUT"] } },
        "structuredOutput": { "type": "boolean" },
        "inputUSDPerMillion": { "type": ["number", "null"], "minimum": 0 },
        "outputUSDPerMillion": { "type": ["number", "null"], "minimum": 0 },
        "transcriptionUSDPerMinute": { "type": ["number", "null"], "minimum": 0 },
        "makeActive": { "type": "boolean" },
        "disclosureAcknowledged": { "const": true }
      }
    },
    "providerConfigurationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "profileId", "operation", "capabilities", "isActive", "secretStored", "configuredAt"],
      "properties": {
        "schemaVersion": { "const": "ai-artifact/provider-configuration/v1" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "profileId": { "$ref": "#/$defs/uuid" },
        "configurationRevisionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "operation": { "enum": ["UPSERT", "ACTIVATE", "DELETE"] },
        "displayName": { "type": ["string", "null"], "maxLength": 500 },
        "adapter": { "type": ["string", "null"], "enum": ["OPENAI_RESPONSES", "OPENAI_COMPATIBLE", "ANTHROPIC_MESSAGES", "GEMINI_GENERATE_CONTENT", null] },
        "baseURL": { "type": ["string", "null"], "maxLength": 2048 },
        "textModel": { "type": ["string", "null"], "maxLength": 500 },
        "transcriptionModel": { "type": ["string", "null"], "maxLength": 500 },
        "capabilities": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["TEXT", "VISION", "TRANSCRIPTION", "STRUCTURED_OUTPUT"] } },
        "isActive": { "type": "boolean" },
        "secretStored": { "type": "boolean" },
        "configuredAt": { "type": "string", "format": "date-time" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceKind", "title", "locator", "excerpt"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/uuid" },
        "sourceKind": { "enum": ["NOTE_BLOCK", "ANNOTATION", "PDF_PAGE"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 12000 }
      }
    },
    "noteQuerySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceKind", "title", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/uuid" },
        "sourceKind": { "enum": ["NOTE_BLOCK", "LASSO_SELECTION"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "excerpt": { "type": ["string", "null"], "minLength": 1, "maxLength": 12000 },
        "imageContent": {
          "type": ["string", "null"],
          "description": "Base64-encoded PNG of a drawing block region. Max 2 MiB decoded.",
          "maxLength": 2796204
        }
      }
    },
    "noteQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "noteId", "question", "selectionSources", "contextSources", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "note-query-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "noteId": { "$ref": "#/$defs/uuid" },
        "noteTitle": { "type": ["string", "null"], "maxLength": 500 },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "selectionSources": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": { "$ref": "#/$defs/noteQuerySource" }
        },
        "contextSources": {
          "type": "array", "minItems": 0, "maxItems": 200,
          "items": { "$ref": "#/$defs/noteQuerySource" }
        },
        "disclosureAcknowledged": { "const": true },
        "providerRoute": { "$ref": "#/$defs/providerRoute" }
      }
    },
    "noteQueryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "answer", "citedSourceIds"],
      "properties": {
        "schemaVersion": { "const": "note-query-response/v1" },
        "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "citedSourceIds": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "followUpQuestions": {
          "type": "array", "maxItems": 5,
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "mathGraphDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumX", "maximumX"],
      "properties": {
        "minimumX": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "maximumX": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
      }
    },
    "mathWorkedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expression", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "expression": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "mathErrorDiagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "observed", "explanation", "correction"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["RECOGNITION", "NOTATION", "CONCEPTUAL", "METHOD", "ALGEBRA", "ARITHMETIC", "VERIFICATION"] },
        "observed": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "correction": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "mathAssistanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "noteId", "mode", "outputLanguage", "selectionSources", "contextSources", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "math-assistance-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "noteId": { "$ref": "#/$defs/uuid" },
        "noteTitle": { "type": ["string", "null"], "maxLength": 500 },
        "mode": { "enum": ["RECOGNIZE", "WORKED_STEPS", "GRAPH", "DIAGNOSE"] },
        "learnerInstructions": { "type": ["string", "null"], "maxLength": 2000 },
        "outputLanguage": { "type": "string", "minLength": 1, "maxLength": 64 },
        "selectionSources": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/$defs/noteQuerySource" }
        },
        "contextSources": {
          "type": "array", "minItems": 0, "maxItems": 40,
          "items": { "$ref": "#/$defs/noteQuerySource" }
        },
        "disclosureAcknowledged": { "const": true },
        "providerRoute": { "$ref": "#/$defs/providerRoute" }
      }
    },
    "mathAssistanceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recognizedExpression", "latex", "interpretation", "steps", "diagnoses", "confidence", "uncertainties", "citedSourceIds"],
      "properties": {
        "schemaVersion": { "const": "math-assistance-response/v1" },
        "recognizedExpression": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "latex": { "type": "string", "maxLength": 4000 },
        "interpretation": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "steps": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/mathWorkedStep" } },
        "finalAnswer": { "type": ["string", "null"], "maxLength": 2000 },
        "diagnoses": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/mathErrorDiagnosis" } },
        "graphExpression": { "type": ["string", "null"], "maxLength": 500 },
        "graphDomain": { "anyOf": [{ "$ref": "#/$defs/mathGraphDomain" }, { "type": "null" }] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainties": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } },
        "citedSourceIds": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "sessionDigestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "sessionId", "sessionTitle", "startedAt", "endedAt", "sources", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "session-digest-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "courseId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "sessionTitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/source" } },
        "userInstructions": { "type": ["string", "null"], "maxLength": 2000 },
        "disclosureAcknowledged": { "const": true },
        "providerRoute": { "$ref": "#/$defs/providerRoute" }
      }
    },
    "citedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "sessionDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "title", "summary", "keyPoints", "possibleMisconceptions", "followUpQuestions"],
      "properties": {
        "schemaVersion": { "const": "session-digest/v1" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "keyPoints": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/citedStatement" } },
        "possibleMisconceptions": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/citedStatement" } },
        "followUpQuestions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "pdfExtractionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "resourceId", "assetId", "assetKey", "expectedDedupeTag", "title"],
      "properties": {
        "schemaVersion": { "enum": ["pdf-extraction-request/v1", "pdf-extraction-request/v2"] },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "resourceId": { "$ref": "#/$defs/uuid" },
        "assetId": { "$ref": "#/$defs/uuid" },
        "assetKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "expectedDedupeTag": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceVersionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "automaticOCR": { "type": "boolean" },
        "automaticFormulaOCR": { "type": "boolean" },
        "preferredOCRLanguages": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "maxLength": 32 } }
      }
    },
    "ocrRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "localOCRRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "alternatives", "rectangles"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["TEXT", "FORMULA"] },
        "text": { "type": "string", "maxLength": 20000 },
        "latex": { "type": ["string", "null"], "maxLength": 20000 },
        "normalizedExpression": { "type": ["string", "null"], "maxLength": 8000 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "alternatives": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 8000 } },
        "rectangles": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ocrRectangle" } }
      }
    },
    "localOCRRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "targetKind", "targetId", "parentId", "inputRevision", "imageContent", "preferredLanguages", "mode", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "local-ocr-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "targetKind": { "enum": ["NOTEBOOK_REGION", "IMAGE", "SOURCE_PAGE"] },
        "targetId": { "$ref": "#/$defs/uuid" },
        "parentId": { "$ref": "#/$defs/uuid" },
        "noteId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "sourceVersionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "inputRevision": { "type": "integer", "minimum": 0 },
        "pageNumber": { "type": ["integer", "null"], "minimum": 1 },
        "locator": { "type": ["object", "null"] },
        "imageContent": { "type": "string", "minLength": 4, "maxLength": 1100000 },
        "preferredLanguages": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "maxLength": 32 } },
        "mode": { "enum": ["TEXT", "FORMULA", "MIXED"] },
        "disclosureAcknowledged": { "const": true }
      }
    },
    "localOCRResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "engine", "engineVersion", "regions", "warnings"],
      "properties": {
        "schemaVersion": { "const": "local-ocr-response/v1" },
        "engine": { "enum": ["APPLE_VISION", "PP_FORMULANET_PLUS_S", "DETERMINISTIC"] },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelVersion": { "type": ["string", "null"], "maxLength": 128 },
        "recognitionVersion": { "type": ["integer", "null"], "minimum": 0 },
        "regions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/localOCRRegion" } },
        "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "ocrArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "jobId", "targetKind", "targetId", "parentId", "inputRevision", "inputFingerprint", "generatedAt", "state", "response"],
      "properties": {
        "schemaVersion": { "const": "recognition-artifact/v1" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "targetKind": { "enum": ["NOTEBOOK_REGION", "IMAGE", "SOURCE_PAGE"] },
        "targetId": { "$ref": "#/$defs/uuid" },
        "parentId": { "$ref": "#/$defs/uuid" },
        "inputRevision": { "type": "integer", "minimum": 0 },
        "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "state": { "enum": ["CURRENT", "STALE"] },
        "response": { "$ref": "#/$defs/localOCRResponse" }
      }
    },
    "ocrCorrection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "artifactId", "regionId", "targetId", "originalText", "correctedText", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "ocr-correction/v1" },
        "artifactId": { "$ref": "#/$defs/uuid" },
        "regionId": { "$ref": "#/$defs/uuid" },
        "targetId": { "$ref": "#/$defs/uuid" },
        "originalText": { "type": "string", "maxLength": 20000 },
        "correctedText": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "state": { "enum": ["ACTIVE", "CONFLICTED", "RETRACTED"] },
        "supersedesCorrectionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "supersedesCorrectionIds": { "type": ["array", "null"], "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "conflictsWithCorrectionId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "localModelControlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "accountId", "jobId", "operation", "modelId", "disclosureAcknowledged"],
      "properties": {
        "schemaVersion": { "const": "local-model-control-request/v1" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["STATUS", "INSTALL", "REMOVE"] },
        "modelId": { "const": "PP-FormulaNet_plus-S" },
        "disclosureAcknowledged": { "const": true }
      }
    },
    "localModelStatusArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "jobId", "modelId", "modelVersion", "operation", "state", "expectedBytes", "verifiedBytes", "license", "checkedAt"],
      "properties": {
        "schemaVersion": { "const": "ai-artifact/local-model-status/v1" },
        "jobId": { "$ref": "#/$defs/uuid" },
        "modelId": { "const": "PP-FormulaNet_plus-S" },
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "enum": ["STATUS", "INSTALL", "REMOVE"] },
        "state": { "enum": ["NOT_INSTALLED", "INSTALLED", "INVALID"] },
        "expectedBytes": { "type": "integer", "minimum": 0 },
        "verifiedBytes": { "type": "integer", "minimum": 0 },
        "license": { "const": "Apache-2.0" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
